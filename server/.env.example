# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is listed in .gitignore.

NODE_ENV=development
PORT=4000

# From MongoDB Atlas → your cluster → Connect → Drivers.
# Replace <db_username> and <db_password> with the database user you create.
# If the password contains special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=finance-tracker

# Name of the database inside the cluster (created automatically on first write)
MONGODB_DB_NAME=finance-tracker

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT value on Vercel. Changing it logs everyone out.
JWT_SECRET=<paste-a-long-random-string-here>

# Optional, LOCAL ONLY. Uncomment if you get "querySrv ECONNREFUSED":
# it makes Node use public DNS servers to look up the Atlas address.
# Do NOT add this on Vercel.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Password reset by email (optional locally) ----
# Locally, leave these unset: the reset email is printed in this terminal
# (EMAIL_PROVIDER defaults to "console") and links point to localhost:5173.
#
# On Vercel (Production), set all four. See docs/MAINTENANCE.md §5a.
#   EMAIL_PROVIDER = brevo   (free; sender can be your verified Gmail address)
#                  or resend (free; needs your own domain to email other people)
#   EMAIL_API_KEY  = the API key from Brevo / Resend
#   EMAIL_FROM     = Finance Tracker <the-verified-sender@example.com>
#   APP_URL        = https://finance-tracker-swart-psi.vercel.app   (no trailing /)
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=
# APP_URL=
