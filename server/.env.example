# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is listed in .gitignore.

NODE_ENV=development
PORT=4000

# From MongoDB Atlas → your cluster → Connect → Drivers.
# Replace <db_username> and <db_password> with the database user you create.
# If the password contains special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=finance-tracker

# Name of the database inside the cluster (created automatically on first write)
MONGODB_DB_NAME=finance-tracker

# Optional, LOCAL ONLY. Uncomment if you get "querySrv ECONNREFUSED":
# it makes Node use public DNS servers to look up the Atlas address.
# Do NOT add this on Vercel.
# DNS_SERVERS=8.8.8.8,1.1.1.1
